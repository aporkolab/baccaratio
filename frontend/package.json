{
  "name": "baccaratio",
  "version": "1.0.0",
  "engines": {
    "node": "^24.15.0",
    "npm": ">=10 <12"
  },
  "scripts": {
    "ng": "ng",
    "start": "npx serve -s dist/baccaratio",
    "build": "ng build --configuration=production --extra-webpack-config webpack.config.js",
    "postinstall": "npm run build",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "test:dependency-guards": "node --test vendor/braces/test.cjs"
  },
  "private": true,
  "homepage": "https://www.baccaratio.aporkolab.com",
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "baccaratio": "file:",
    "dotenv": "^17.4.2",
    "dotenv-webpack": "^9.0.0",
    "rxjs": "~7.8.2",
    "serve": "^14.2.6",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^26.5.0",
    "@types/webpack": "^5.28.5",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ngx-build-plus": "^20.0.0",
    "typescript": "~6.0.3",
    "webpack": "^5.110.3",
    "webpack-merge": "^6.0.1",
    "braces": "file:vendor/braces"
  },
  "overrides": {
    "braces": "$braces",
    "compression": "^1.8.2"
  }
}
